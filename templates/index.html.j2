            <svg class="flora-plant flora-plant--l" aria-hidden="true" focusable="false" viewBox="0 0 120 300" xmlns="http://www.w3.org/2000/svg"><use href="#sp-fern"/></svg>
            <svg class="flora-plant flora-plant--r" aria-hidden="true" focusable="false" viewBox="0 0 120 300" xmlns="http://www.w3.org/2000/svg"><use href="#sp-sage"/></svg>
        </div>
        <!-- Deals the two margin specimens fresh on every visit. The page ships a
             valid pair in the markup above, so with JS off nothing is missing —
             it just stops being a different sheet each time. -->
        <script>
        (() => {
          const herbs = ["fern", "rosemary", "sage", "thyme",
                         "lavender", "dill", "chives", "bay"];
          const slots = document.querySelectorAll(".flora-plant");
          const n = herbs.length;
          const a = (Math.random() * n) | 0;
          // Offset by 1..n-1 rather than redrawing, so the margins never pair a
          // herb with itself and the two sides always read as two specimens.
          const b = (a + 1 + ((Math.random() * (n - 1)) | 0)) % n;
          [a, b].forEach((pick, i) => {
            slots[i].firstElementChild.setAttribute("href", `#sp-${herbs[pick]}`);
            slots[i].style.setProperty("--flora-scale", (0.86 + Math.random() * 0.3).toFixed(2));
          });
        })();
        </script>
        <div class="container">
            <main class="profile">
                <div class="avatar">
                    <picture>
                        <source media="(min-width: 640px) and (hover: hover) and (pointer: fine)" srcset="avatar-plain.webp" type="image/webp">
                        <source media="(min-width: 640px) and (hover: hover) and (pointer: fine)" srcset="avatar-plain.png">
                        <source srcset="avatar.webp" type="image/webp">
                        <!-- alt="" on purpose: the <h1> below carries the name, and neither
                             variant adds information it doesn't already state. A described
                             alt here just makes a screen reader say "Mike Fiedler" twice. -->
                        <img src="avatar.png" alt="" width="512" height="512">
                    </picture>
                </div>
                <h1 class="name">{{ name }}</h1>
                <p class="title">{{ title }}</p>
                <p class="description">{{ description }}</p>
                <div class="links">
                    {% for link in links %}
                        <a href="{{ link.url | safe }}"
                           class="link-item"
                           rel="noopener noreferrer{% if link.rel %} {{ link.rel }}{% endif %}"
                           target="_blank">
                            {{ icon_svg(link.icon) | safe }}
                            <span>{{ link.label }}</span>
                            {% if link.note %}<span class="link-note">{{ link.note }}</span>{% endif %}
                        </a>
                    {% endfor %}
                </div>
                {% if visible_extras %}
                <div class="extras-section">
                    <div class="ornament">
                        <svg aria-hidden="true" width="120" height="16" viewBox="0 0 120 16" xmlns="http://www.w3.org/2000/svg">
                            <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1">
                                <line x1="0" y1="8" x2="48" y2="8"/>
                                <path d="M 52 8 Q 60 1 68 8 Q 60 15 52 8 Z"/>
                                <path d="M 53 8 Q 57 5 65 6" stroke-width="0.6"/>
                                <line x1="72" y1="8" x2="120" y2="8"/>
                            </g>
                        </svg>
                    </div>
                    <h2 class="extras-heading">Extras</h2>
                    <div class="extras-links">
                        {% for extra in visible_extras %}
                            <a href="{{ extra.url | safe }}"
                               class="link-item"
                               rel="noopener noreferrer"
                               target="_blank">
                                {{ icon_svg(extra.icon) | safe }}
                                <div class="extra-link-content">
                                    <span>{{ extra.label }}</span>
                                    <span class="extra-link-date">{{ extra.date }}{% if extra.filemeta %} · {{ extra.filemeta }}{% endif %}</span>
                                </div>
                            </a>
                        {% endfor %}
                        {% if expandable_extras %}
                        <details class="extras-details">
                            <summary class="extras-summary">
                                <span class="extras-summary-more">Show more ({{ expandable_extras|length }})</span>
                                <span class="extras-summary-less">Show less</span>
                            </summary>
                            <div class="extras-expandable">
                                {% for extra in expandable_extras %}
                                    <a href="{{ extra.url | safe }}"
                                       class="link-item"
                                       rel="noopener noreferrer"
                                       target="_blank">
                                        {{ icon_svg(extra.icon) | safe }}
                                        <div class="extra-link-content">
                                            <span>{{ extra.label }}</span>
                                            <span class="extra-link-date">{{ extra.date }}{% if extra.filemeta %} · {{ extra.filemeta }}{% endif %}</span>
                                        </div>
                                    </a>
                                {% endfor %}
                            </div>
                        </details>
                        {% endif %}
                    </div>
                </div>
                {% endif %}
            </main>
            <footer class="sheet-footer">
                <p class="provenance">
                    Identity: <a href="{{ verification.profile_url | safe }}" rel="me">verified on Mastodon</a>, published as <a href="human.json">human.json</a>
                </p>
                <p class="footer">Updated {{ updated_date }}</p>
            </footer>
        </div>
    </body>
</html>
