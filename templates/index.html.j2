<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <!-- Themes the browser's own surfaces (scrollbars, form UI) alongside ours -->
        <meta name="color-scheme" content="light dark">
        <!-- Primary Meta Tags -->
        <title>{{ name }} - {{ seo_title }}</title>
        <meta name="title" content="{{ name }} - {{ seo_title }}">
        <meta name="description" content="{{ seo_description }}">
        <meta name="author" content="{{ name }}">
        <!-- Open Graph / Facebook -->
        <meta property="og:type" content="website">
        <meta property="og:url" content="{{ site_url | safe }}">
        <meta property="og:title" content="{{ name }} - {{ seo_title }}">
        <meta property="og:description" content="{{ seo_description }}">
        <meta property="og:image" content="{{ site_url | safe }}/og.png">
        <!-- Twitter -->
        <meta property="twitter:card" content="summary_large_image">
        <meta property="twitter:url" content="{{ site_url | safe }}">
        <meta property="twitter:title" content="{{ name }} - {{ seo_title }}">
        <meta property="twitter:description" content="{{ seo_description }}">
        <meta property="twitter:image" content="{{ site_url | safe }}/og.png">
        <meta property="twitter:creator" content="{{ twitter_handle }}">
        <!-- Favicon -->
        <link rel="icon" type="image/png" sizes="32x32" href="favicon.png">
        <!-- Preload the LCP avatar — picture source's media query decides which to fetch.
             type="image/webp" means a browser without webp skips the preload and
             falls through to the PNG source below, so nothing is fetched twice. -->
        <link rel="preload" as="image" href="avatar.webp" type="image/webp" fetchpriority="high" media="not all and (min-width: 640px) and (hover: hover) and (pointer: fine)">
        <link rel="preload" as="image" href="avatar-plain.webp" type="image/webp" fetchpriority="high" media="(min-width: 640px) and (hover: hover) and (pointer: fine)">
        <!-- Fonts: self-hosted (see assets/fonts/ + just fonts); @font-face inlined in <style> below -->
        <!-- Icons are inlined SVG (from Font Awesome Free 7.2.0) — see assets/icons/ and just icons -->
        <!-- Verification -->
        <link rel="me" href="https://hachyderm.io/@miketheman">
        <link rel="human-json" href="/human.json">
        <style>
{{ fonts_css | safe }}
    @layer tokens, base, components;

    @layer tokens {
      :root {
        /* Color — warm paper/ink with a botanical accent.
           QR colors are pinned to pure black/white for scan reliability. */
        --c-bg: #f4f1ea;
        --c-fg: #1c1a17;
        --c-fg-muted: #5a554d;
        --c-fg-subtle: #6b6559;
        --c-rule: #d8d2c4;
        --c-surface-hover: #ebe4d4;
        --c-accent: #3f5a3a;
        --c-qr-bg: #ffffff;

        /* Type — editorial serif + humanist grotesque + mono */
        --font-display: "Petrona", ui-serif, Georgia, serif;
        --font-body: "Hanken Grotesk", ui-sans-serif, system-ui, sans-serif;

        --text-xs:   clamp(0.75rem,  0.73rem + 0.10vw, 0.8125rem);
        --text-sm:   clamp(0.875rem, 0.85rem + 0.15vw, 0.9375rem);
        --text-base: clamp(1rem,     0.96rem + 0.20vw, 1.0625rem);
        --text-xl:   clamp(1.5rem,   1.38rem + 0.60vw, 1.75rem);
        /* ~4% over the other steps: Petrona's x-height runs smaller than the
           body face, so the name needs the bump to hold the same presence. */
        --text-2xl:  clamp(2.0625rem, 1.77rem + 1.56vw, 2.875rem);

        --leading-tight: 1.1;
        --leading-body:  1.55;

        --tracking-tight: -0.015em;
        --tracking-wide:   0.06em;
        --tracking-caps:   0.14em;

        /* Space — 4px geometric */
        --space-1: 0.25rem;
        --space-2: 0.5rem;
        --space-3: 0.75rem;
        --space-4: 1rem;
        --space-5: 1.5rem;
        --space-7: 3rem;

        /* Form */
        --radius-sm: 2px;
        --rule: 1px solid var(--c-rule);

        /* Motion (reduced via @media below) */
        --ease: cubic-bezier(0.2, 0.8, 0.2, 1);
        --dur: 180ms;

        /* The margin specimens grow in once, on load. Far slower than any UI
           transition because it isn't one — nothing waits on it and nothing is
           only legible after it. The curve starts slow and settles long, the
           way a thing grows; a standard UI ease-out finished in the first third
           and then crawled. */
        --dur-grow: 2600ms;
        --ease-grow: cubic-bezier(0.45, 0.05, 0.25, 1);
        /* Mixed from the muted ink rather than set to the rule color: a rule is
           read at 1px against paper it sits next to, but a specimen is read as a
           whole shape across a lot of empty margin, and at rule strength it
           disappeared. Still no new hue — this is the page's own ink, thinned. */
        --flora-ink: color-mix(in oklab, var(--c-fg-muted) 62%, transparent);
        --flora-opacity: 1;

        /* A11y */
        --hit: 44px;
        --focus-ring: 2px solid var(--c-accent);
        --focus-offset: 3px;

        /* Layout */
        --container: 36rem;
      }

      @media (prefers-color-scheme: dark) {
        :root {
          --c-bg: #14130f;
          --c-fg: #ece7d9;
          --c-fg-muted: #a6a094;
          --c-fg-subtle: #90897d;
          --c-rule: #2d2b26;
          --c-surface-hover: #1e1c17;
          --c-accent: #a2c087;
          /* QR tokens intentionally un-themed — scans need pure contrast. */
        }
      }

      /* Zeroing the duration lands the growth on its end state, which is also
         its resting state — so reduced motion still gets the specimens, just
         already grown. Nothing meaningful is conveyed only by the movement. */
      @media (prefers-reduced-motion: reduce) {
        :root { --dur: 0ms; --dur-grow: 0ms; }
      }
    }

    @layer base {
      *, *::before, *::after { box-sizing: border-box; }

      body {
        margin: 0;
        padding: var(--space-5) var(--space-4);
        background: var(--c-bg);
        color: var(--c-fg);
        font-family: var(--font-body);
        font-size: var(--text-base);
        line-height: var(--leading-body);
        display: flex;
        justify-content: center;
        min-height: 100svh;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      a { color: inherit; }

      :focus-visible {
        outline: var(--focus-ring);
        outline-offset: var(--focus-offset);
        border-radius: var(--radius-sm);
      }
    }

    @layer components {
      .container {
        position: relative;
        z-index: 1;
        width: 100%;
        max-width: var(--container);
      }

      .profile {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: var(--space-5);
      }

      /* QR container — pinned light regardless of theme so phone cameras scan reliably.
         Double-rule mat: outer border + inner hairline via ::before. */
      .avatar {
        position: relative;
        width: 100%;
        max-width: 512px;
        background: var(--c-qr-bg);
        padding: var(--space-5);
        border: var(--rule);
      }

      .avatar::before {
        content: "";
        position: absolute;
        inset: var(--space-2);
        border: var(--rule);
        pointer-events: none;
      }

      .avatar img {
        width: 100%;
        height: auto;
        display: block;
        position: relative;
      }

      @media (max-width: 600px) {
        .avatar { max-width: 320px; }
      }

      /* Desktop: drop the rectangular mat frame; circular border hugs the portrait.
         The portrait is identity, not payload — at 512px it pushed every link
         below the fold on a 1280x800 laptop. The QR needs its size to scan; a
         face does not. */
      @media (min-width: 640px) and (hover: hover) and (pointer: fine) {
        .avatar {
          max-width: 220px;
          background: transparent;
          padding: 0;
          border-radius: 50%;
        }
        .avatar::before { display: none; }
      }

      .name {
        margin: 0;
        font-family: var(--font-display);
        font-size: var(--text-2xl);
        font-weight: 400;
        line-height: var(--leading-tight);
        letter-spacing: var(--tracking-tight);
        text-align: center;
      }

      .title {
        margin: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: var(--space-3);
        font-size: var(--text-sm);
        font-weight: 500;
        letter-spacing: var(--tracking-caps);
        text-transform: uppercase;
        color: var(--c-fg-muted);
      }

      .title::before,
      .title::after {
        content: "";
        flex-shrink: 0;
        width: 1.5rem;
        height: 1px;
        background: var(--c-accent);
      }

      .description {
        margin: 0;
        max-width: 30rem;
        text-align: center;
        color: var(--c-fg-muted);
      }

      .links, .extras-links, .extras-expandable {
        display: flex;
        flex-direction: column;
        gap: var(--space-3);
        width: 100%;
      }

      .link-item {
        display: flex;
        align-items: center;
        gap: var(--space-4);
        min-height: var(--hit);
        padding: var(--space-4) var(--space-5);
        border: var(--rule);
        border-radius: var(--radius-sm);
        text-decoration: none;
        color: var(--c-fg);
        transition: background-color var(--dur) var(--ease),
                    border-color var(--dur) var(--ease),
                    transform var(--dur) var(--ease);
      }

      .link-item:hover,
      .link-item:focus-visible {
        background: var(--c-surface-hover);
        border-color: var(--c-fg-muted);
      }

      .link-item:active { transform: translateY(1px); }

      .link-item svg {
        width: 1.4em;
        height: 1.4em;
        flex-shrink: 0;
        color: var(--c-fg-muted);
        transition: color var(--dur) var(--ease);
      }

      .link-item:hover svg,
      .link-item:focus-visible svg {
        color: var(--c-accent);
      }

      /* Extras — hand-set botanical ornament replaces a plain divider rule */
      .extras-section {
        width: 100%;
        margin-top: var(--space-7);
      }

      .ornament {
        display: flex;
        justify-content: center;
        color: var(--c-accent);
        margin-bottom: var(--space-5);
      }

      .ornament svg { display: block; }

      .extras-heading {
        margin: 0 0 var(--space-4);
        font-size: var(--text-xs);
        font-weight: 500;
        letter-spacing: var(--tracking-caps);
        text-transform: uppercase;
        text-align: center;
        color: var(--c-fg-muted);
      }

      .extra-link-content {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: var(--space-1);
      }

      /* Dated rows wrap to 2–3 lines, so centering strands the icon beside the
         middle of the block. Pin it to the first line it labels instead. */
      .link-item:has(.extra-link-content) {
        align-items: flex-start;
      }

      .link-item:has(.extra-link-content) svg {
        margin-top: calc((1em * var(--leading-body) - 1.4em) / 2);
      }

      /* The quiet second line under a row label — a date on extras, a
         disambiguating note on links. Same size, same tier. */
      .extra-link-date,
      .link-note {
        font-size: var(--text-xs);
        color: var(--c-fg-subtle);
      }

      /* Wide tracking and tabular figures belong to dates and measurements,
         where they align a column. Prose set at 0.06em just reads slower. */
      .extra-link-date {
        font-variant-numeric: tabular-nums;
        letter-spacing: var(--tracking-wide);
      }

      /* The note rides the label's line, flush right, so a row that carries one
         is the same height as a row that doesn't. A ragged stack of 59px and
         81px rows reads as a mistake; the column edge is what holds the list
         together. Below 22rem there is genuinely no room beside the label, so
         it drops under — keep notes short enough that this stays an edge case. */
      .link-note {
        margin-left: auto;
        padding-left: var(--space-3);
        text-align: right;
        text-wrap: balance;
      }

      @media (max-width: 22rem) {
        .links .link-item { flex-wrap: wrap; }
        .link-note {
          margin-left: calc(1.4em + var(--space-4));
          padding-left: 0;
          width: 100%;
          text-align: left;
        }
      }

      .extras-details { width: 100%; }

      .extras-summary {
        list-style: none;
        min-height: var(--hit);
        margin-top: var(--space-3);
        padding: var(--space-3) var(--space-4);
        border: var(--rule);
        border-radius: var(--radius-sm);
        cursor: pointer;
        text-align: center;
        font-size: var(--text-xs);
        font-weight: 500;
        letter-spacing: var(--tracking-caps);
        text-transform: uppercase;
        color: var(--c-fg-muted);
        transition: background-color var(--dur) var(--ease),
                    border-color var(--dur) var(--ease);
      }

      .extras-summary::-webkit-details-marker { display: none; }

      /* The label has to answer the state it's in — "Show more" while the rows
         are already open reads as a broken control. */
      .extras-summary-less,
      .extras-details[open] .extras-summary-more { display: none; }

      .extras-details[open] .extras-summary-less { display: inline; }

      .extras-summary:hover,
      .extras-summary:focus-visible {
        background: var(--c-surface-hover);
        border-color: var(--c-fg-muted);
      }

      .extras-expandable { margin-top: var(--space-3); }

      /* Bottom annotation block — the provenance note and the date stamp read as
         one determination slip at the foot of the sheet, not two stray lines. */
      .sheet-footer {
        margin-top: var(--space-7);
        text-align: center;
        font-size: var(--text-xs);
        color: var(--c-fg-subtle);
      }

      .provenance {
        margin: 0;
        line-height: var(--leading-body);
        text-wrap: balance;
      }

      .provenance a {
        text-decoration: underline;
        text-decoration-thickness: 1px;
        text-underline-offset: 0.2em;
      }

      .footer {
        margin: var(--space-3) 0 0;
        font-variant-numeric: tabular-nums;
        letter-spacing: var(--tracking-wide);
      }

      /* ---------------------------------------------------------------------
         Margin specimens

         Hairline herbs that grow up out of the bottom edge on load. Everything
         they need lives in this block; the only pieces outside it are the four
         tokens in :root, where every token on this page lives. Last in the
         layer because they sit behind the sheet — nothing above depends on them.

         Drawn in the page's own ink, thinned — never in the accent. The green
         has four jobs, and staying rare is what makes it read as tended rather
         than branded.
         --------------------------------------------------------------------- */
      .flora {
        position: fixed;
        inset: 0;
        z-index: 0;
        overflow: hidden;
        pointer-events: none;
        contain: layout paint style;
      }

      .flora-defs { position: absolute; width: 0; height: 0; }

      /* Two mask layers, intersected. The first is the growth reveal, sweeping
         from the ground up; the second is the narrow-screen fringe, a no-op at
         full width. Keeping both in one property means one compositing pass and
         one place to reason about what is hiding what. */
      .flora-plant {
        position: absolute;
        bottom: 0;
        width: auto;
        aspect-ratio: 2 / 5;
        color: var(--flora-ink);
        opacity: var(--flora-opacity);
        --fringe: linear-gradient(#000, #000);
        /* The 100% fallback matters on browsers without @property support: there
           --grow has no declared value, and without it the whole mask-image
           would be invalid — taking the narrow-screen fringe down with it and
           putting full-strength stems back behind the body copy. */
        mask-image:
          linear-gradient(to top, #000 0 var(--grow, 100%), transparent calc(var(--grow, 100%) + 14%)),
          var(--fringe);
        mask-composite: intersect;
        animation: flora-grow var(--dur-grow) var(--ease-grow) backwards;
      }

      /* Stroke width in user units rather than vector-effect:non-scaling-stroke:
         0.55 against the ~2.1–2.6x render scale lands at roughly 1.2–1.4px, the
         page's hairline, without the vector-effect's device-space quirks. */
      .flora-plant use { stroke-width: 0.55; }

      /* The right-hand specimen trails the left so the two don't grow in
         lockstep, which would read as one animation on two copies. */
      .flora-plant--r { animation-delay: 600ms; }

      /* Registered so it interpolates — an unregistered custom property would
         jump from 0 to 100 with nothing in between. */
      @property --grow {
        syntax: "<percentage>";
        inherits: false;
        initial-value: 100%;
      }

      /* The reveal starts fully below the mask's edge, so nothing is on screen
         until the plant has actually grown into it. 100% is the resting state,
         which is what a zeroed --dur-grow lands on under reduced motion. */
      @keyframes flora-grow { from { --grow: -15%; } }

      .flora-plant--l { left: -5rem; }
      .flora-plant--r { right: -5rem; transform: scaleX(-1); }

      /* Narrow: one specimen, not two, and never centred.

         Two edge fringes gave a phone leaf tips with no visible stem, which
         reads as texture rather than as a plant. A single specimen with enough
         of itself showing reads as the thing it is. Centring it was worse than
         either: the column is the whole screen here, so a centred stem runs
         straight down through the name, the role line and every link row — a
         scratch across exactly where the eye reads.

         So it stays at the edge, wide enough to be a plant, and only its outer
         leaves and a thinned stem reach the text. The QR mat is opaque in every
         theme, so scanning is untouched, and the stem appears to grow out from
         behind it.

         Right edge, not left. Every link row is left-aligned — icon, then label
         — so the left edge is where the eye lands on every line, and a specimen
         there crossed all six of them. The right edge is ragged line-ends. Same
         plant, same size: 3 text elements touched instead of 7, and not one
         link label among them. */
      @media (max-width: 55.99rem) {
        .flora-plant--l { display: none; }

        .flora-plant--r {
          right: -3rem;
          height: calc(clamp(360px, 88svh, 680px) * var(--flora-scale, 1));
          opacity: 0.6;
          --fringe: linear-gradient(to right, #000 0 42%, transparent 88%);
          /* Nothing to stagger against when it's the only one on screen. */
          animation-delay: 0ms;
        }
      }

      /* Wide: the specimens move out into the real margin and never touch the
         column. The second term caps height by the gutter itself — the gutter
         is (50vw - half the column - a gutter of air) wide, and the box is 2:5,
         so height tops out at 2.5x that. The plant is only ever as tall as the
         space it has, and thins away to nothing as the margin closes. */
      @media (min-width: 56rem) {
        .flora-plant {
          height: min(
            calc(clamp(340px, 88svh, 780px) * var(--flora-scale, 1)),
            calc((50vw - var(--container) / 2 - var(--space-4)) * 2.5)
          );
        }
        .flora-plant--l { left: auto; right: calc(50% + var(--container) / 2 + var(--space-4)); }
        .flora-plant--r { right: auto; left: calc(50% + var(--container) / 2 + var(--space-4)); }
      }
    }
        </style>
    </head>
    <body>
